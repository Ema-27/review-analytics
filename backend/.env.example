# Copiare in .env e personalizzare se necessario. Tutti i valori hanno un
# default sensato: l'applicazione funziona anche senza alcuna modifica.

ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://tourinsight:tourinsight@db:5432/tourinsight

# --- Apify (opzionale) ---
# Se non impostato, il sistema usa automaticamente il dataset di esempio
# incluso (app/data/sample_reviews.json) per garantire una demo funzionante.
# Ottenere un token gratuito su https://console.apify.com/settings/integrations
APIFY_API_TOKEN=
APIFY_TRIPADVISOR_ACTOR_ID=maxcopell/tripadvisor-reviews

# --- AI provider ---
# ollama            (default) sentiment/aspetti via Hugging Face + generazione
#                   testuale via LLM instruct locale servito dal container Ollama
#                   (nessuna chiave richiesta, gratuito e offline dopo il 1o download)
# huggingface_local solo modelli Hugging Face in-process (generazione con
#                   flan-t5-base: piu' leggero ma qualita' in italiano scarsa)
# mock              euristica lessicale istantanea, per test/demo rapidissime
AI_PROVIDER=ollama
HF_DEVICE=cpu

# Modello Ollama per la generazione (letto anche dal job ollama-init che lo
# pre-scarica). Default: gemma2:2b (~2 GB RAM, buona qualita' in italiano su CPU).
# Alternative: qwen2.5:3b (piu' verboso, ~2x piu' lento), qwen2.5:0.5b (rapido, scarso).
# Dopo averlo cambiato: `docker compose up -d` (ricrea backend e ri-scarica).
OLLAMA_MODEL=gemma2:2b

CORS_ALLOW_ORIGINS=*
